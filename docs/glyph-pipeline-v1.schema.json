{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linuxct.space/glyphworks/schema/glyph.pipeline.v1.json",
  "title": "GlyphWorks pipeline format version 1",
  "description": "Portable executable block data, with no code, permissions, activation or runtime state. Semantic validation by the runtime is also required.",
  "type": "object",
  "properties": {
    "format": {
      "const": "glyph.pipeline"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "author": {
      "type": "string",
      "maxLength": 256
    },
    "createdAt": {
      "type": "string"
    },
    "modifiedAt": {
      "type": "string"
    },
    "createdWith": {
      "type": "string"
    },
    "entryPoint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/program"
      },
      "maxItems": 128
    },
    "routines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routine"
      },
      "maxItems": 128
    },
    "designs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/design"
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "enum": [
          13,
          25
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "editor": {
      "$ref": "#/$defs/editor"
    },
    "preview": {
      "$ref": "#/$defs/preview"
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "id",
    "name",
    "entryPoint",
    "programs"
  ],
  "$defs": {
    "valueType": {
      "enum": [
        "NUMBER",
        "BOOLEAN",
        "TEXT",
        "DURATION",
        "VECTOR",
        "LIST",
        "RECORD",
        "ANY"
      ]
    },
    "unit": {
      "enum": [
        "SCALAR",
        "MILLISECONDS",
        "DEGREES",
        "RADIANS_PER_SECOND",
        "METERS_PER_SECOND_SQUARED",
        "LUX",
        "PERCENT",
        "CELLS"
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            "unit": {
              "$ref": "#/$defs/unit"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "vector"
            },
            "x": {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            "y": {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            "z": {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            "unit": {
              "$ref": "#/$defs/unit"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "x",
            "y"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "list"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              },
              "maxItems": 1024
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "record"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "expression": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "key": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          },
          "maxItems": 1024
        }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/valueType"
        },
        "default": {
          "$ref": "#/$defs/value"
        },
        "description": {
          "type": "string"
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ]
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "quickSetting": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "variable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/valueType"
        },
        "initial": {
          "$ref": "#/$defs/value"
        },
        "persistent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "block": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "op": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          }
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 4096
        },
        "otherwise": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 4096
        },
        "comment": {
          "type": "string",
          "maxLength": 4096
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "op"
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/expression"
            },
            {
              "type": "null"
            }
          ]
        },
        "edge": {
          "enum": [
            "EVENT",
            "RISING",
            "FALLING",
            "CHANGE"
          ]
        },
        "initially": {
          "type": "boolean"
        },
        "stableForMs": {
          "type": "integer",
          "minimum": 0
        },
        "calendar": {
          "anyOf": [
            {
              "$ref": "#/$defs/calendarTrigger"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "script": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "name": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 4096
        },
        "reentry": {
          "enum": [
            "RESTART",
            "IGNORE",
            "QUEUE",
            "PARALLEL"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "program": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "TOY",
            "AMBIENT",
            "CONTROLLER",
            "ROUTINE"
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          },
          "maxItems": 128
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "maxItems": 256
        },
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/script"
          },
          "maxItems": 128
        },
        "description": {
          "type": "string"
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "templateVersion": {
          "type": "integer"
        },
        "immediateAction": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "routine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "name": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          },
          "maxItems": 128
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "maxItems": 256
        },
        "returns": {
          "$ref": "#/$defs/valueType"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 4096
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "geometry": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "anchorX": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        "anchorY": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        "hitX": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        "hitY": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        "hitWidth": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        "hitHeight": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{0,64}$"
        },
        "playback": {
          "enum": [
            "NATURAL",
            "STRETCH_TO_PHASE",
            "LOOP",
            "HOLD_LAST"
          ]
        },
        "transparentZero": {
          "type": "boolean"
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/geometry"
          }
        },
        "routineId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "assetId"
          ],
          "properties": {
            "assetId": {
              "minLength": 1
            },
            "routineId": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "routineId"
          ],
          "properties": {
            "routineId": {
              "type": "string",
              "minLength": 1
            },
            "assetId": {
              "const": ""
            }
          }
        }
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        "y": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        }
      },
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        "y": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        "scale": {
          "type": "number",
          "maximum": 1000000000000000.0,
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "editor": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/position"
          },
          "maxProperties": 4096
        },
        "collapsed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
          },
          "maxItems": 4096
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "selected": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "capability"
      ]
    },
    "design": {
      "type": "object",
      "description": "A complete glyph.design formatVersion 1 document; validated using the existing design codec.",
      "required": [
        "format",
        "formatVersion",
        "id",
        "variants"
      ],
      "properties": {
        "format": {
          "const": "glyph.design"
        },
        "formatVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "variants": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "calendarTrigger": {
      "type": "object",
      "properties": {
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        }
      },
      "additionalProperties": false
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thumbnailAssetId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "thumbnailFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 239
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "initialAction": {
          "type": "boolean"
        }
      }
    }
  }
}
